# Copy to .env and fill in. Never commit .env.

# --- Telegram ---
APP_TELEGRAM__BOT_TOKEN=
# Comma-separated Telegram user IDs of global admins (more can be added in the bot menu)
APP_TELEGRAM__ADMIN_TELEGRAM_IDS=
# Optional: group chats (comma-separated chat IDs) where admins may use the settings menu
APP_TELEGRAM__ADMIN_CHAT_IDS=
APP_TELEGRAM__WEBHOOK_ENABLED=false
APP_TELEGRAM__WEBHOOK_BASE_URL=
APP_TELEGRAM__WEBHOOK_PATH=/telegram/webhook
APP_TELEGRAM__WEBHOOK_SECRET_TOKEN=
# Optional proxy for Telegram Bot API calls (bot and worker):
# socks5://host:1080, socks4://host:1080, http://host:3128 (socks5h/socks4a also accepted).
# Credentials either in the URL (percent-encoded) or in the two variables below.
APP_TELEGRAM__PROXY_URL=
APP_TELEGRAM__PROXY_USERNAME=
APP_TELEGRAM__PROXY_PASSWORD=

# --- PostgreSQL ---
APP_DATABASE__HOST=postgres
APP_DATABASE__PORT=5432
APP_DATABASE__NAME=telegram_sla_bot
APP_DATABASE__USER=telegram_sla_bot
APP_DATABASE__PASSWORD=

# --- Redis ---
APP_REDIS__HOST=redis
APP_REDIS__PORT=6379
APP_REDIS__PASSWORD=

# --- Behaviour (optional) ---
APP_APP__ENVIRONMENT=production
APP_APP__DEFAULT_TIMEZONE=Europe/Moscow
APP_APP__DEFAULT_SLA_SECONDS=900
APP_APP__DEFAULT_PRIORITY=p3
APP_APP__DEFAULT_REPLY_MATCH_MODE=any_responder_message
APP_APP__RESPONSIBLE_CAN_MARK_NOT_REQUIRED=true
APP_APP__AUTO_ADD_RESPONSIBLE_AS_RESPONDER=true
APP_APP__MERGE_CONSECUTIVE_MESSAGES=true
APP_APP__HTTP_PORT=8080

# --- Celery (optional) ---
APP_CELERY__SCAN_INTERVAL_SECONDS=30
APP_CELERY__SCAN_BATCH_SIZE=100
APP_CELERY__MAX_DELIVERY_ATTEMPTS=8
APP_CELERY__RESEND_STALE_NOTIFICATIONS=false

# --- Logging ---
APP_LOGGING__LEVEL=INFO
APP_LOGGING__JSON_FORMAT=true
